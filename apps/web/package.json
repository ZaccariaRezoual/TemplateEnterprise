{
  "name": "@enterprise/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue 3 frontend application of the Enterprise Framework. Feature-first architecture consuming the design system (@enterprise/ui) and the generated SDK (@enterprise/sdk).",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@enterprise/module-auth": "workspace:*",
    "@enterprise/module-authorization": "workspace:*",
    "@enterprise/module-dashboard": "workspace:*",
    "@enterprise/module-localization": "workspace:*",
    "@enterprise/module-notifications": "workspace:*",
    "@enterprise/module-realtime": "workspace:*",
    "@enterprise/module-site": "workspace:*",
    "@enterprise/module-users": "workspace:*",
    "@enterprise/sdk": "workspace:*",
    "@enterprise/shared": "workspace:*",
    "@enterprise/types": "workspace:*",
    "@enterprise/ui": "workspace:*",
    "@heroicons/vue": "^2.2.0",
    "@tanstack/vue-query": "^5.101.4",
    "@vueuse/core": "^14.4.0",
    "motion-v": "^2.3.0",
    "pinia": "^4.0.2",
    "vue": "catalog:",
    "vue-router": "^5.2.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
