  "components": {
    "schemas": {
      "AuditEntryDto": {
        "required": [
          "id",
          "userId",
          "action",
          "source",
          "succeeded",
          "correlationId",
          "occurredAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Entry identifier.",
            "format": "uuid"
          },
          "userId": {
            "type": ["null", "string"],
            "description": "Account that acted, or null when anonymous.",
            "format": "uuid"
          },
          "action": {
            "type": "string",
            "description": "Stable action name."
          },
          "source": {
            "type": "string",
            "description": "How the entry was produced."
          },
          "succeeded": {
            "type": "boolean",
            "description": "Whether the operation succeeded."
          },
          "correlationId": {
            "type": ["null", "string"],
            "description": "Correlation id, to join with the logs."
          },
          "occurredAtUtc": {
            "type": "string",
            "description": "When the action occurred.",
            "format": "date-time"
          }
        },
        "description": "Audit entry as exposed to clients."
      },
      "AuthResponse": {
        "required": ["accessToken", "accessTokenExpiresAtUtc", "user"],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Signed JWT to send as a Bearer header."
          },
          "accessTokenExpiresAtUtc": {
            "type": "string",
            "description": "Expiry of the access token.",
            "format": "date-time"
          },
          "user": {
            "description": "The authenticated account.",
            "$ref": "#/components/schemas/UserDto"
          }
        },
        "description": "Body returned by register, login and refresh.\r\n\r\nDeliberately does NOT contain the refresh token: that travels only in an\r\nhttpOnly cookie, out of reach of any script (XSS containment). The access\r\ntoken is meant to be held in memory by the client, never persisted."
      },
      "EchoCommand": {
        "required": ["text"],
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to echo. Required, max 500 characters (see validator)."
          }
        },
        "description": "Sample command proving validation and event publishing end-to-end.\r\nEchoes the given text back and publishes DemoEchoedEvent."
      },
      "EchoResponse": {
        "required": ["text", "length"],
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The echoed text."
          },
          "length": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "description": "Length of the echoed text, in characters.",
            "format": "int32"
          }
        },
        "description": "Response contract of EchoCommand."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": ["null", "string"]
          },
          "title": {
            "type": ["null", "string"]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["null", "integer", "string"],
            "format": "int32"
          },
          "detail": {
            "type": ["null", "string"]
          },
          "instance": {
            "type": ["null", "string"]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "LocaleDto": {
        "required": ["code", "name"],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "BCP 47 tag, e.g. \"en\" or \"it\"."
          },
          "name": {
            "type": "string",
            "description": "Name shown in a language picker, in that language."
          }
        },
        "description": "A locale the application supports."
      },
      "LoginCommand": {
        "required": ["email", "password"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address of the account."
          },
          "password": {
            "type": "string",
            "description": "Raw password to verify."
          }
        },
        "description": "Authenticates an account with email and password."
      },
      "MarkReadRequest": {
        "required": ["notificationId"],
        "type": "object",
        "properties": {
          "notificationId": {
            "type": ["null", "string"],
            "description": "The notification to mark, or null for all.",
            "format": "uuid"
          }
        },
        "description": "Body of the \"mark read\" endpoint."
      },
      "NotificationDto": {
        "required": ["id", "title", "body", "level", "link", "isUnread", "createdAtUtc"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Notification identifier.",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "description": "Short headline."
          },
          "body": {
            "type": "string",
            "description": "Explanatory text."
          },
          "level": {
            "type": "string",
            "description": "Severity used for styling."
          },
          "link": {
            "type": ["null", "string"],
            "description": "Optional in-app link."
          },
          "isUnread": {
            "type": "boolean",
            "description": "Whether the user has not read it yet."
          },
          "createdAtUtc": {
            "type": "string",
            "description": "When it was created.",
            "format": "date-time"
          }
        },
        "description": "A notification as exposed to clients."
      },
      "NotifyMeCommand": {
        "required": ["title", "body"],
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Headline of the notification."
          },
          "body": {
            "type": "string",
            "description": "Explanatory text."
          }
        },
        "description": "Sends the caller a notification.\r\n\r\nExists so the realtime path is demonstrable and testable end to end: it\r\npublishes a notification request exactly as any real feature would, and\r\neverything after that — persistence, the realtime push, the badge and the\r\ntoast — happens without this module knowing any of it exists."
      },
      "PagedResultOfUserProfileDto": {
        "required": ["items", "page", "pageSize", "totalCount"],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserProfileDto"
            },
            "description": "Items of the current page."
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "description": "1-based page index.",
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "description": "Maximum items per page.",
            "format": "int32"
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "description": "Total items across all pages.",
            "format": "int32"
          }
        },
        "description": "A page of results."
      },
      "PingResponse": {
        "required": ["message", "timestampUtc"],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Static confirmation message."
          },
          "timestampUtc": {
            "type": "string",
            "description": "Server UTC time at which the query was handled.",
            "format": "date-time"
          }
        },
        "description": "Response contract of PingQuery (exposed by the API and,\r\nthrough OpenAPI, by the generated SDK)."
      },
      "RegisterCommand": {
        "required": ["email", "displayName", "password"],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address; must be unique."
          },
          "displayName": {
            "type": "string",
            "description": "Name shown in the UI."
          },
          "password": {
            "type": "string",
            "description": "Raw password; hashed before persistence, never stored."
          }
        },
        "description": "Creates a new account and signs it in."
      },
      "RoleDto": {
        "required": ["id", "name", "description", "isBuiltIn", "permissions"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Role identifier.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Unique role name."
          },
          "description": {
            "type": "string",
            "description": "What the role is for."
          },
          "isBuiltIn": {
            "type": "boolean",
            "description": "Whether the framework owns the role (not deletable)."
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Permissions granted by the role."
          }
        },
        "description": "Role as exposed to clients."
      },
      "SetSettingRequest": {
        "required": ["value"],
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "Raw value; must parse as the setting's declared type."
          }
        },
        "description": "Body of the \"set setting\" endpoints."
      },
      "SettingDto": {
        "required": ["key", "value", "description", "scope", "valueType", "isOverriddenByUser"],
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Setting key."
          },
          "value": {
            "type": "string",
            "description": "Effective value after layering."
          },
          "description": {
            "type": "string",
            "description": "What the setting controls."
          },
          "scope": {
            "type": "string",
            "description": "Where it may be overridden."
          },
          "valueType": {
            "type": "string",
            "description": "Declared type of the value."
          },
          "isOverriddenByUser": {
            "type": "boolean",
            "description": "Whether the caller has their own value."
          }
        },
        "description": "One effective setting as seen by the caller."
      },
      "SetUserRolesRequest": {
        "required": ["roleNames"],
        "type": "object",
        "properties": {
          "roleNames": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The complete new set of role names."
          }
        },
        "description": "Body of the \"set user roles\" endpoint."
      },
      "UpdateUserRequest": {
        "required": ["displayName", "jobTitle", "isActive"],
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "New display name."
          },
          "jobTitle": {
            "type": ["null", "string"],
            "description": "New job title, or null to clear it."
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether the account is active."
          }
        },
        "description": "Body of the \"update user\" endpoint."
      },
      "UserAuthorizationDto": {
        "required": ["roles", "permissions"],
        "type": "object",
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Role names granted to the account."
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every permission the account effectively holds."
          }
        },
        "description": "Effective authorization of an account: its roles and the union of their\r\npermissions. Returned by the \"my permissions\" endpoint the frontend uses\r\nto drive the UI."
      },
      "UserDto": {
        "required": ["id", "email", "displayName"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Account identifier.",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "Email address."
          },
          "displayName": {
            "type": "string",
            "description": "Name shown in the UI."
          }
        },
        "description": "Account identity exposed to clients. Entities never cross the API\r\nboundary; this DTO is what OpenAPI (and therefore the SDK) sees.\r\n\r\nIt carries no roles or permissions on purpose: those belong to the\r\nAuthorization module and are served by `GET /api/authorization/me`.\r\nReturning them here would create a second source of truth that silently\r\ngoes stale."
      },
      "UserProfileDto": {
        "required": ["id", "email", "displayName", "jobTitle", "isActive", "createdAtUtc"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Account identifier.",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "description": "Email address."
          },
          "displayName": {
            "type": "string",
            "description": "Name shown in the UI."
          },
          "jobTitle": {
            "type": ["null", "string"],
            "description": "Optional job title."
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether the account is active."
          },
          "createdAtUtc": {
            "type": "string",
            "description": "When the account was created.",
            "format": "date-time"
          }
        },
        "description": "User profile as exposed to clients."
      }
    }
