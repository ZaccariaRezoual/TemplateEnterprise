<!--
  Module Contract: IModule, module.json manifest model and the loader.
  Referenced by BOTH the host (Api) and every module backend, so neither
  depends on the other (no circular references).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>EnterpriseFramework.Modules.Abstractions</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Application\EnterpriseFramework.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Needed for IServiceCollection/IConfiguration/IEndpointRouteBuilder in the contract. -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="MediatR" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Shared persistence helpers modules apply in OnModelCreating. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
