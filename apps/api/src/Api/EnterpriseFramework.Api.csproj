<!--
  Api layer: ASP.NET Core Minimal API host and composition root.
  The ONLY project that references Infrastructure and the module backends;
  it wires everything together (DI, middleware, module loading).
-->
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>EnterpriseFramework.Api</RootNamespace>
    <!-- Write the OpenAPI document to a stable, source-controlled path on every
         build: packages/sdk is generated from this file, so the SDK is always
         in sync with the API and its diff is reviewable in pull requests. -->
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Application\EnterpriseFramework.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\EnterpriseFramework.Infrastructure.csproj" />
    <ProjectReference
      Include="..\Modules.Abstractions\EnterpriseFramework.Modules.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\..\modules\demo\backend\EnterpriseFramework.Modules.Demo.csproj" />
    <ProjectReference Include="..\..\..\..\modules\auth\backend\EnterpriseFramework.Modules.Auth.csproj" />
    <ProjectReference
      Include="..\..\..\..\modules\authorization\backend\EnterpriseFramework.Modules.Authorization.csproj" />
    <ProjectReference
      Include="..\..\..\..\modules\users\backend\EnterpriseFramework.Modules.Users.csproj" />
    <ProjectReference
      Include="..\..\..\..\modules\audit\backend\EnterpriseFramework.Modules.Audit.csproj" />
    <ProjectReference
      Include="..\..\..\..\modules\settings\backend\EnterpriseFramework.Modules.Settings.csproj" />
    <ProjectReference
      Include="..\..\..\..\modules\email\backend\EnterpriseFramework.Modules.Email.csproj" />
    <ProjectReference
      Include="..\..\..\..\modules\storage\backend\EnterpriseFramework.Modules.Storage.csproj" />
    <ProjectReference
      Include="..\..\..\..\modules\notifications\backend\EnterpriseFramework.Modules.Notifications.csproj" />
    <ProjectReference
      Include="..\..\..\..\modules\localization\backend\EnterpriseFramework.Modules.Localization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Design-time only: enables `dotnet ef` with this project as startup. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Direct reference only to lift the vulnerable transitive Microsoft.OpenApi 2.0.0. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Seq" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
  </ItemGroup>
</Project>
