{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=enterprise;Username=app;Password=dev_password",
    "Redis": "localhost:6379"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": ["FromLogContext"]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "enterprise-framework",
    "Audience": "enterprise-framework",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "PermitLimit": 600,
    "WindowSeconds": 60
  },
  // Enterprise features: all opt-in, all off by default.
  // See docs/enterprise-features.md.
  "Tenancy": {
    "Enabled": false,
    "Strategy": "Header",
    "HeaderName": "X-Tenant-Id"
  },
  "Features": {
    "Flags": {}
  },
  "Observability": {
    "Enabled": false,
    "ServiceName": "enterprise-api",
    "OtlpEndpoint": "http://localhost:4317",
    "SamplingRatio": 1.0
  },
  "Modules": {}
}
