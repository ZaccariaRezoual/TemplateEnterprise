{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Jwt": {
    "SigningKey": "local-development-only-signing-key-0123456789abcdef"
  },
  "Modules": {
    "Auth": {
      // Development hammers these endpoints (hot reloads, parallel e2e runs)
      // from a single IP. Production keeps the strict default of 10.
      "CredentialsPermitLimit": 200
    }
  }
}
