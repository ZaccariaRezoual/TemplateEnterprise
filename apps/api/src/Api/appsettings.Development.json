{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Jwt": {
    "SigningKey": "local-development-only-signing-key-0123456789abcdef"
  },
  "RateLimiting": {
    // Development runs hot reloads and parallel e2e workers from one IP.
    "PermitLimit": 5000
  },
  "Modules": {
    "Auth": {
      // Development hammers these endpoints (hot reloads, parallel e2e runs)
      // from a single IP. Production keeps the strict default of 10.
      "CredentialsPermitLimit": 200,
      // First way in: a fresh database has no account able to administer
      // anything, and promoting one requires a permission nobody holds yet.
      // Development only — the password is public in this repository, so a
      // deployment that enables it MUST set its own.
      "BootstrapAdmin": {
        "Enabled": true,
        "Email": "admin@example.com",
        "DisplayName": "Admin",
        "Password": "Password123!"
      }
    }
  }
}
