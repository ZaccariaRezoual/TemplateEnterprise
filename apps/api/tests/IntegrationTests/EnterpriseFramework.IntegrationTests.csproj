<!--
  Integration tests: boot the real API host in-memory (WebApplicationFactory)
  and exercise HTTP endpoints end-to-end (routing, middleware, MediatR
  pipeline, ProblemDetails mapping).
  Tests that require live PostgreSQL/Redis will use Testcontainers from Fase 4.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>EnterpriseFramework.IntegrationTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Api\EnterpriseFramework.Api.csproj" />
    <!-- Tests reach into the Authorization schema to promote a test account,
         which no HTTP endpoint allows without an already-privileged caller. -->
    <ProjectReference
      Include="..\..\..\..\modules\authorization\backend\EnterpriseFramework.Modules.Authorization.csproj" />
    <!-- Publishing a notification exactly as another module would. -->
    <ProjectReference
      Include="..\..\..\..\modules\notifications\shared\EnterpriseFramework.Modules.Notifications.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
</Project>
