<!--
  Storage module: file upload/download with a swappable storage provider.
  Metadata lives in its own schema; bytes live wherever the provider puts them.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>EnterpriseFramework.Modules.Storage</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\..\..\apps\api\src\Application\EnterpriseFramework.Application.csproj" />
    <ProjectReference
      Include="..\..\..\apps\api\src\Modules.Abstractions\EnterpriseFramework.Modules.Abstractions.csproj" />
    <ProjectReference
      Include="..\..\authorization\backend\EnterpriseFramework.Modules.Authorization.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\module.json" LogicalName="module.json" />
  </ItemGroup>
</Project>
