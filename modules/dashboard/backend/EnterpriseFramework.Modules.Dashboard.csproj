<!--
  Dashboard module: aggregates the tiles other modules contribute.

  References NO other module. It collects every IDashboardWidgetProvider the
  container knows about, so the set of tiles is whatever is installed.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>EnterpriseFramework.Modules.Dashboard</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\..\..\apps\api\src\Application\EnterpriseFramework.Application.csproj" />
    <ProjectReference
      Include="..\..\..\apps\api\src\Modules.Abstractions\EnterpriseFramework.Modules.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MediatR" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\module.json" LogicalName="module.json" />
  </ItemGroup>
</Project>
