<!--
  Public contracts of the Site module: the integration events other modules
  subscribe to.

  Kept in its own tiny assembly so a subscriber references ONLY the event
  shapes, never the Site implementation.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>EnterpriseFramework.Modules.Site.Contracts</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\apps\api\src\Domain\EnterpriseFramework.Domain.csproj" />
  </ItemGroup>
</Project>
