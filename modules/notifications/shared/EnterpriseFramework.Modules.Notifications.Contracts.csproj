<!--
  Public contract of the Notifications module: the request other modules
  publish to notify a user, without referencing this module's implementation.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>EnterpriseFramework.Modules.Notifications.Contracts</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\apps\api\src\Domain\EnterpriseFramework.Domain.csproj" />
    <!-- For IRealtimeEvent: declaring an event as client-facing needs the
         abstraction, not the Realtime module. -->
    <ProjectReference
      Include="..\..\..\apps\api\src\Application\EnterpriseFramework.Application.csproj" />
  </ItemGroup>
</Project>
