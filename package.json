{
  "name": "enterprise-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Vue.NET Framework 2026 — monorepo root. Hosts shared tooling (lint, format, hooks) and orchestrates workspace-wide scripts.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,vue}": "eslint --fix",
    "*.{js,mjs,cjs,ts,mts,vue,json,md,yml,yaml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
