# Shared editor settings for the whole monorepo.
# JS/TS formatting details are owned by Prettier; C# rules by Directory.Build.props + analyzers.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.cs]
indent_size = 4

# C# style rules enforced as build warnings (warnings are errors, see Directory.Build.props)
dotnet_diagnostic.IDE0005.severity = warning
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf
