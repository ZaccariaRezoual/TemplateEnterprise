{
  "name": "@enterprise/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the API, generated from its OpenAPI document. The frontend calls the API exclusively through this package — hand-written endpoint URLs are not allowed.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi/v1.json --output ./src/generated/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.1"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
